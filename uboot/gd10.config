# Appended to mainline U-Boot v2024.01 configs/p200_defconfig.
# HDMI console and USB keyboard, so boot problems are visible on the TV.
CONFIG_VIDEO=y
CONFIG_VIDEO_MESON=y
CONFIG_VIDEO_DT_SIMPLEFB=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_POWER_DOMAIN=y
CONFIG_MESON_EE_POWER_DOMAIN=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_KEYBOARD=y
CONFIG_CMD_USB=y
CONFIG_PHY=y
CONFIG_MESON_GXBB_USB_PHY=y
CONFIG_DM_REGULATOR_GPIO=y
CONFIG_CMD_FAT=y
CONFIG_BOOTDELAY=3
# Lets bootm load Amlogic vendor kernel.img files when experimenting.
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_LZO=y
